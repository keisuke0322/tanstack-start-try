{
  "name": "tanstack-start-try",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:api\"",
    "dev:frontend": "bun --filter @tanstack-start-try/frontend dev",
    "dev:api": "bun --filter @tanstack-start-try/api dev",
    "build": "bun run build:types && bun run build:api && bun run build:frontend",
    "build:types": "bun --filter @tanstack-start-try/types build",
    "build:frontend": "bun --filter @tanstack-start-try/frontend build",
    "build:api": "bun --filter @tanstack-start-try/api build",
    "check": "bun --filter @tanstack-start-try/frontend check",
    "fix": "bun --filter @tanstack-start-try/frontend fix",
    "test": "bun --filter @tanstack-start-try/frontend test && bun --filter @tanstack-start-try/api test",
    "test:watch": "bun --filter @tanstack-start-try/frontend test:watch",
    "test:api": "bun --filter @tanstack-start-try/api test",
    "test:api:watch": "bun --filter @tanstack-start-try/api test:watch",
    "test:api:coverage": "bun --filter @tanstack-start-try/api test:coverage",
    "test:e2e": "bun --filter @tanstack-start-try/frontend test:e2e"
  },
  "dependencies": {
    "@vercel/node": "^5.5.16",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "lefthook": "^2.0.12",
    "typescript": "^5.7.0"
  }
}
