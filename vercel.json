{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build:frontend",
  "outputDirectory": "apps/frontend/.output",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "functions": {
    "apps/api/api/index.ts": {
      "runtime": "edge"
    }
  }
}
