{
  "name": "tanstack-start-try",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:api\"",
    "dev:frontend": "bun --filter @tanstack-start-try/frontend dev",
    "dev:api": "bun --filter @tanstack-start-try/api dev",
    "build": "bun run build:frontend",
    "build:frontend": "bun --filter @tanstack-start-try/frontend build",
    "build:api": "bun --filter @tanstack-start-try/api build",
    "check": "bun --filter @tanstack-start-try/frontend check",
    "fix": "bun --filter @tanstack-start-try/frontend fix",
    "test": "bun --filter @tanstack-start-try/frontend test",
    "test:watch": "bun --filter @tanstack-start-try/frontend test:watch",
    "test:e2e": "bun --filter @tanstack-start-try/frontend test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "lefthook": "^2.0.12"
  }
}
