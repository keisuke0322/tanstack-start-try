{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build:types && bun run build:frontend && cp -r apps/frontend/.vercel/output .vercel/output",
  "outputDirectory": ".vercel/output",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...route]]" }
  ]
}
